# 单个项目实例的环境模板 —— 复制成 .env.<项目名> 后填写。
# 由 new-project.ps1 自动生成并填入部分字段。

# 项目标识（决定容器名前缀，必须唯一）
SUPERAGENT_PROFILE=project-a
# 容器内监听端口；不同项目必须不同
SUPERAGENT_PORT=3085
# dsh-shared 网络别名：网关用它访问本项目，必须唯一
PROJECT_ALIAS=project-a

# 镜像来源：默认从 main 构建
SUPERAGENT_REPO=https://github.com/Lafinger/dsh-superagent-prototype.git
SUPERAGENT_REF=main
DSH_VERSION=0.2.1-rc.3
LARK_CLI_VERSION=1.0.90
GH_VERSION=2.103.3

TZ=Asia/Shanghai

# 飞书应用（每个项目一个独立应用，否则事件会互相抢占）
LARK_APP_ID=
LARK_APP_SECRET=

# GitHub 机器账号（有仓库写权限）
GH_TOKEN=
GH_USER=lafinger-agent
GITHUB_REPOSITORY=

# 模型供应商（默认 linkcode，与宿主机一致）
MODEL_PROVIDER=linkcode
MODEL_BASE_URL=https://direct.linkcode.site/v1
MODEL_NAME=deepseek-v4.1-flash-1017
MODEL_APIKEY_ENV=LINKCODE_API_KEY
LINKCODE_API_KEY=
CPA_API_KEY=
